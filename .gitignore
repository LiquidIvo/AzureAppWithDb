# --- Terraform ---
# Local directory for modules and provider plugins
.terraform/

# Terraform state files (critical so you don't leak secrets or corrupt state)
*.tfstate
*.tfstate.*

# Terraform execution plans
*.tfplan
*.tfplan.*

# Crash log files
crash.log
crash.pfi

# Exclude local variable files containing secrets (uncomment if you want to keep tfvars local)
# *.tfvars
# *.tfvars.json

# --- .NET / Visual Studio ---
# Build outputs and object files
[Bb]in/
[Oo]bj/

# Visual Studio user-specific files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Publish directory
[Pp]ublish/